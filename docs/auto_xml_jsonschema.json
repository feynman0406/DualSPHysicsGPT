{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DualSPHysics AutoXML Generator Contract (JSON Mode, Strict S1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["constants", "mkconfig", "geometry", "casedef_extra", "execution"],
  "properties": {
    "constants": {
      "type": "object",
      "description": "Constants mapped into <constantsdef>. Require full official set; allow extras.",
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "$ref": "#/$defs/vector" },
          { "$ref": "#/$defs/nodeSpecOrAttrs" }
        ]
      },
      "required": [
        "lattice",
        "gravity",
        "rhop0",
        "rhopgradient",
        "hswl",
        "gamma",
        "speedsystem",
        "coefsound",
        "speedsound",
        "coefh",
        "_hdp",
        "cflnumber",
        "h",
        "b",
        "massbound",
        "massfluid"
      ],
      "properties": {
        "gravity": { "$ref": "#/$defs/vector" },
        "rhop0": { "type": "number" },
        "gamma": { "type": "number" },
        "speedsystem": { "type": "number" },
        "coefsound": { "type": "number" },
        "speedsound": { "type": "number" },
        "coefh": { "type": "number" },
        "_hdp": { "type": "number" },
        "cflnumber": { "type": "number" },
        "hswl": { "oneOf": [ { "type": "number" }, { "$ref": "#/$defs/nodeSpecOrAttrs" } ] },
        "rhopgradient": { "oneOf": [ { "type": "number" }, { "$ref": "#/$defs/nodeSpecOrAttrs" } ] },
        "lattice": { "oneOf": [ { "type": "number" }, { "$ref": "#/$defs/nodeSpecOrAttrs" } ] },
        "h": { "oneOf": [ { "type": "number" }, { "$ref": "#/$defs/nodeSpecOrAttrs" } ] },
        "b": { "oneOf": [ { "type": "number" }, { "$ref": "#/$defs/nodeSpecOrAttrs" } ] },
        "massbound": { "oneOf": [ { "type": "number" }, { "$ref": "#/$defs/nodeSpecOrAttrs" } ] },
        "massfluid": { "oneOf": [ { "type": "number" }, { "$ref": "#/$defs/nodeSpecOrAttrs" } ] }
      }
    },
    "mkconfig": {
      "type": "object",
      "additionalProperties": true,
      "required": ["boundcount", "fluidcount"],
      "properties": {
        "boundcount": { "type": "integer", "minimum": 0 },
        "fluidcount": { "type": "integer", "minimum": 0 }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "commands"],
      "properties": {
        "definition": {
          "type": "object",
          "additionalProperties": true,
          "required": ["dp", "pointmin", "pointmax"],
          "properties": {
            "dp": { "type": "number", "exclusiveMinimum": 0 },
            "pointmin": { "$ref": "#/$defs/vector" },
            "pointmax": { "$ref": "#/$defs/vector" }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mainlist"],
          "properties": {
            "lists": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "items"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "items": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/command" }
                  }
                }
              }
            },
            "mainlist": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/command" }
            }
          }
        },
        "extra": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/nodeSpec" }
        }
      }
    },
    "casedef_extra": {
      "type": "array",
      "items": { "$ref": "#/$defs/nodeSpec" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["parameters"],
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "number" },
              { "$ref": "#/$defs/vector" },
              { "$ref": "#/$defs/nodeSpecOrAttrs" }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "nodeSpec": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tag": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "attributes": { "type": "object" },
        "vector": { "$ref": "#/$defs/vector" },
        "text": { "type": ["string", "number", "boolean"] },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeSpec" }
        },
        "extra": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeSpec" }
        }
      }
    },
    "nodeSpecOrAttrs": {
      "oneOf": [
        { "$ref": "#/$defs/nodeSpec" },
        {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      ]
    },
    "childPoint": {
      "type": "object",
      "required": ["tag", "vector"],
      "properties": {
        "tag": { "const": "point" },
        "vector": { "$ref": "#/$defs/vector" }
      }
    },
    "childSize": {
      "type": "object",
      "required": ["tag", "vector"],
      "properties": {
        "tag": { "const": "size" },
        "vector": { "$ref": "#/$defs/vector" }
      }
    },
    "childBoxfill": {
      "type": "object",
      "required": ["tag", "text"],
      "properties": {
        "tag": { "const": "boxfill" },
        "text": { "type": "string" }
      }
    },
    "childModefill": {
      "type": "object",
      "required": ["tag", "text"],
      "properties": {
        "tag": { "const": "modefill" },
        "text": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "name"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "runlist" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "drawpoints", "drawshapes"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "setactive" },
            "drawpoints": { "type": "integer", "enum": [0, 1] },
            "drawshapes": { "type": "integer", "enum": [0, 1] }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "setshapemode" },
            "text": { "type": "string", "enum": ["actual", "bound"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "mode"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "setdrawmode" },
            "mode": { "type": "string", "enum": ["full"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "mk"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["setmkfluid", "setmkbound"] },
            "mk": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["type", "vdp"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "layers" },
            "vdp": { "type": "string", "pattern": "^(\\d+)(,\\d+)*$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "file"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "shapeout" },
            "file": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "resetdraw" }
          }
        },
        {
          "type": "object",
          "required": ["type", "children"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "drawbox" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/nodeSpec" },
              "allOf": [
                { "contains": { "$ref": "#/$defs/childBoxfill" }, "minContains": 1 },
                { "contains": { "$ref": "#/$defs/childPoint" }, "minContains": 1 },
                { "contains": { "$ref": "#/$defs/childSize" }, "minContains": 1 }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "children"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "fillbox" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/nodeSpec" },
              "allOf": [
                { "contains": { "$ref": "#/$defs/childModefill" }, "minContains": 1 },
                { "contains": { "$ref": "#/$defs/childPoint" }, "minContains": 1 },
                { "contains": { "$ref": "#/$defs/childSize" }, "minContains": 1 }
              ]
            }
          }
        }
      ]
    }
  }
}
