<?xml version='1.0' encoding='UTF-8'?>
<case>
  <casedef>
    <constantsdef>
      <lattice bound="2" fluid="1"/>
      <gravity x="0" y="0" z="-9.81" comment="Gravitational acceleration" units_comment="m/s^2"/>
      <rhop0 value="1000" comment="Reference density of the fluid" units_comment="kg/m^3"/>
      <rhopgradient value="3" comment="Initial density gradient 1:Rhop0, 2:Water column, 3:Max. water height (default=2)"/>
      <hswl value="0" auto="true" comment="Maximum still water level to calculate speedofsound using coefsound" units_comment="metres (m)"/>
      <gamma value="7" comment="Polytropic constant for water used in the state equation"/>
      <speedsystem value="0" auto="true" comment="Maximum system speed (by default the dam-break propagation is used)"/>
      <coefsound value="20" comment="Coefficient to multiply speedsystem"/>
      <speedsound value="0" auto="true" comment="Speed of sound to use in the simulation (by default speedofsound=coefsound*speedsystem)"/>
      <coefh value="1.0" comment="Coefficient to calculate the smoothing length (h=coefh*sqrt(3*dp^2) in 3D)"/>
      <cflnumber value="0.2" comment="Coefficient to multiply dt"/>
    </constantsdef>
    <mkconfig boundcount="230" fluidcount="9">
      <mkorientfluid mk="0" orient="Xyz"/>
    </mkconfig>
    <geometry>
      <definition dp="0.1" units_comment="metres (m)">
        <pointref x="0" y="0" z="0"/>
        <pointmin x="-1" y="-1" z="-1"/>
        <pointmax x="17" y="7" z="6"/>
      </definition>
      <commands>
        <mainlist>
          <setshapemode>dp | real | bound</setshapemode>
          <setdrawmode mode="full"/>
          <setmkbound mk="10"/>
          <drawbox cmt="Piston">
            <boxfill>solid</boxfill>
            <point x="0.7" y="0" z="0"/>
            <size x="0.3" y="6" z="5"/>
          </drawbox>
          <setdrawmode mode="face"/>
          <setmkbound mk="20"/>
          <drawbox>
            <boxfill>bottom | right | front | back</boxfill>
            <point x="0" y="0" z="0"/>
            <size x="16" y="6" z="6"/>
          </drawbox>
          <setdrawmode mode="full"/>
          <setmkbound mk="50"/>
          <drawbox>
            <boxfill>solid</boxfill>
            <point x="10" y="2" z="3"/>
            <size x="2" y="2" z="2"/>
          </drawbox>
          <setmkfluid mk="0"/>
          <fillbox x="5" y="2" z="2">
            <modefill>void</modefill>
            <point x="0" y="0" z="0"/>
            <size x="16" y="6" z="4"/>
          </fillbox>
          <shapeout file="" reset="true"/>
        </mainlist>
      </commands>
    </geometry>
    <motion>
      <objreal ref="10">
        <begin mov="1" start="0" finish="100"/>
        <mvrectsinu id="1" duration="50">
          <freq x="0.3" y="0" z="0"/>
          <ampl x="0.5" y="0" z="0"/>
        </mvrectsinu>
      </objreal>
    </motion>
    <floatings>
      <floating mkbound="50">
        <massbody value="10000"/>
      </floating>
    </floatings>
  </casedef>
  <execution>
    <parameters>
      <parameter comment="Saves particle position using double precision (default=0)" key="SavePosDouble" value="0"/>
      <parameter comment="Step Algorithm 1:Verlet, 2:Symplectic (default=1)" key="StepAlgorithm" value="2"/>
      <parameter comment="Verlet only: Number of steps to apply Euler timestepping (default=40)" key="VerletSteps" value="40"/>
      <parameter comment="Interaction Kernel 1:Cubic Spline, 2:Wendland (default=2)" key="Kernel" value="2"/>
      <parameter comment="Viscosity formulation 1:Artificial, 2:Laminar+SPS, 3:Laminar (default=1)" key="ViscoTreatment" value="2"/>
      <parameter comment="Viscosity value. Typically 0.01 for Artificial and 1e-6 m^2/s (water kinematic viscosity) for Laminar" key="Visco" units_comment="m^2/s" value="0.000001"/>
      <parameter comment="Multiply viscosity value with boundary (default=1)" key="ViscoBoundFactor" value="1"/>
      <parameter comment="Density Diffusion Term 0:None, 1:Molteni, 2:Fourtakas, 3:Fourtakas(full) (default=0)" key="DensityDT" value="2"/>
      <parameter comment="DDT value (default=0.1)" key="DensityDTvalue" value="0.1"/>
      <parameter comment="Shifting mode 0:None, 1:Ignore bound, 2:Ignore fixed, 3:Full (default=0)" key="Shifting" value="0"/>
      <parameter comment="Coefficient for shifting computation (default=-2)" key="ShiftCoef" value="-2"/>
      <parameter comment="Threshold to detect free surface. Typically 1.5 for 2D and 2.75 for 3D (default=0)" key="ShiftTFS" value="0"/>
      <parameter comment="Rigid Algorithm 0:collision-free, 1:SPH, 2:DEM, 3:Chrono (default=1)" key="RigidAlgorithm" value="1"/>
      <parameter comment="Time to freeze the floatings at simulation start (warmup) (default=0)" key="FtPause" units_comment="seconds" value="0.0"/>
      <parameter comment="Coefficient to calculate minimum time step dtmin=coefdtmin*h/speedsound (default=0.05)" key="CoefDtMin" value="0.05"/>
      <parameter comment="Initial time step. Use 0 to default use (default=h/speedsound)" key="DtIni" units_comment="seconds" value="0"/>
      <parameter comment="Minimum time step. Use 0 to default use (default=coefdtmin*h/speedsound)" key="DtMin" units_comment="seconds" value="0"/>
      <parameter comment="Fixed Dt value. Use 0 to disable (default=disabled)" key="DtFixed" units_comment="seconds" value="0"/>
      <parameter comment="Dt values are loaded from file. Use NONE to disable (default=disabled)" key="DtFixedFile" units_comment="milliseconds (ms)" value="NONE"/>
      <parameter comment="Velocity of particles used to calculate DT. 1:All, 0:Only fluid/floating (default=0)" key="DtAllParticles" value="0"/>
      <parameter comment="Time of simulation" key="TimeMax" units_comment="seconds" value="10.0"/>
      <parameter comment="Time out data" key="TimeOut" units_comment="seconds" value="0.1"/>
      <parameter comment="%/100 of fluid particles allowed to be excluded from domain (default=1)" key="PartsOutMax" units_comment="decimal" value="1"/>
      <parameter comment="Minimum rhop valid (default=700)" key="RhopOutMin" units_comment="kg/m^3" value="700"/>
      <parameter comment="Maximum rhop valid (default=1300)" key="RhopOutMax" units_comment="kg/m^3" value="1300"/>
      <simulationdomain comment="Defines domain of simulation (default=Uses minimum and maximum position of the generated particles)">
        <posmin x="default" y="default" z="default" comment="e.g.: x=0.5, y=default-1, z=default-10%"/>
        <posmax x="default" y="default" z="default + 20%"/>
      </simulationdomain>
    </parameters>
  </execution>
</case>
