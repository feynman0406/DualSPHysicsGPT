{
  "case_comments": [
    "Zero-gravity container test: square solid block moves through enclosed fluid via prescribed horizontal velocity while boundaries confine the fluid."
  ],
  "constants": {
    "gravity": {
      "x": "0",
      "y": "0",
      "z": "0",
      "comment": "Gravitational acceleration",
      "units_comment": "m/s^2",
      "tag": "gravity"
    },
    "rhop0": {
      "value": "1000",
      "comment": "Reference density of the fluid",
      "units_comment": "kg/m^3",
      "tag": "rhop0"
    },
    "rhopgradient": {
      "value": "1",
      "comment": "Initial density gradient 1:Rhop0, 2:Water column, 3:Max. water height (default=2)",
      "tag": "rhopgradient"
    },
    "hswl": {
      "value": "0",
      "auto": true,
      "comment": "Maximum still water level to calculate speedofsound using coefsound",
      "units_comment": "metres (m)",
      "tag": "hswl"
    },
    "gamma": {
      "value": "7",
      "comment": "Polytropic constant for water used in the state equation",
      "tag": "gamma"
    },
    "speedsystem": {
      "value": "0",
      "auto": true,
      "comment": "Maximum system speed (by default the dam-break propagation is used)",
      "tag": "speedsystem"
    },
    "coefsound": {
      "value": "20",
      "comment": "Coefficient to multiply speedsystem",
      "tag": "coefsound"
    },
    "speedsound": {
      "value": "0",
      "auto": true,
      "comment": "Speed of sound to use in the simulation (by default speedofsound=coefsound*speedsystem)",
      "tag": "speedsound"
    },
    "b": {
      "value": "1.1200e+05",
      "auto": false,
      "tag": "b"
    },
    "coefh": {
      "value": "1.0",
      "comment": "Coefficient to calculate the smoothing length (h=coefh*sqrt(3*dp^2) in 3D)",
      "tag": "coefh"
    },
    "cflnumber": {
      "value": "0.2",
      "comment": "Coefficient to multiply dt",
      "tag": "cflnumber"
    }
  },
  "mkconfig": {
    "boundcount": "240",
    "fluidcount": "9"
  },
  "geometry": {
    "definition": {
      "dp": "0.02",
      "pointmin": {
        "x": "-02",
        "y": "0",
        "z": "-2"
      },
      "pointmax": {
        "x": "10.1",
        "y": "0",
        "z": "5.2"
      },
      "meta": {
        "units_comment": "metres (m)"
      },
      "children": [
        {
          "tag": "pointref",
          "vector": {
            "x": "0",
            "y": "0",
            "z": "0"
          }
        }
      ]
    },
    "commands": {
      "children": [
        {
          "tag": "mainlist",
          "children": [
            {
              "type": "setshapemode",
              "text": "actual | dp | bound"
            },
            {
              "type": "setdrawmode",
              "attributes": {
                "mode": "full"
              }
            },
            {
              "type": "setmkbound",
              "attributes": {
                "mk": "0"
              }
            },
            {
              "type": "drawbox",
              "children": [
                {
                  "tag": "boxfill",
                  "text": "bottom | left | right | top"
                },
                {
                  "tag": "point",
                  "vector": {
                    "x": "0",
                    "y": "-1",
                    "z": "0"
                  }
                },
                {
                  "tag": "size",
                  "vector": {
                    "x": "10",
                    "y": "2",
                    "z": "5"
                  }
                }
              ]
            },
            {
              "type": "setmkbound",
              "attributes": {
                "mk": "10"
              }
            },
            {
              "type": "drawbox",
              "children": [
                {
                  "tag": "boxfill",
                  "text": "solid"
                },
                {
                  "tag": "point",
                  "vector": {
                    "x": "1",
                    "y": "-1",
                    "z": "2"
                  }
                },
                {
                  "tag": "size",
                  "vector": {
                    "x": "1",
                    "y": "2",
                    "z": "1"
                  }
                }
              ]
            },
            {
              "type": "setmkfluid",
              "attributes": {
                "mk": "0"
              }
            },
            {
              "type": "fillbox",
              "attributes": {
                "x": "3",
                "y": "0",
                "z": "1"
              },
              "children": [
                {
                  "tag": "modefill",
                  "text": "void"
                },
                {
                  "tag": "point",
                  "vector": {
                    "x": "0",
                    "y": "-1",
                    "z": "0"
                  }
                },
                {
                  "tag": "size",
                  "vector": {
                    "x": "10",
                    "y": "2",
                    "z": "5"
                  }
                }
              ]
            },
            {
              "type": "shapeout",
              "attributes": {
                "file": ""
              }
            }
          ]
        }
      ]
    }
  },
  "motion": [
    {
      "ref": "10",
      "children": [
        {
          "tag": "begin",
          "mov": "1",
          "start": "0.00",
          "finish": "100"
        },
        {
          "tag": "mvrect",
          "id": "1",
          "duration": "3",
          "children": [
            {
              "tag": "vel",
              "vector": {
                "x": "2.8",
                "y": "0",
                "z": "0"
              }
            }
          ]
        }
      ],
      "type": "objreal"
    }
  ],
  "casedef_children": [
    {
      "type": "section",
      "key": "constants"
    },
    {
      "type": "section",
      "key": "mkconfig"
    },
    {
      "type": "section",
      "key": "geometry"
    },
    {
      "type": "section",
      "key": "motion"
    }
  ],
  "execution": {
    "children_order": [
      "parameters"
    ],
    "parameters": {
      "SavePosDouble": {
        "value": "0",
        "comment": "Saves particle position using double precision (default=0)"
      },
      "StepAlgorithm": {
        "value": "2",
        "comment": "Step Algorithm 1:Verlet, 2:Symplectic (default=1)"
      },
      "VerletSteps": {
        "value": "40",
        "comment": "Verlet only: Number of steps to apply Euler timestepping (default=40)"
      },
      "Kernel": {
        "value": "2",
        "comment": "Interaction Kernel 1:Cubic Spline, 2:Wendland (default=2)"
      },
      "ViscoTreatment": {
        "value": "1",
        "comment": "Viscosity formulation 1:Artificial, 2:Laminar+SPS, 3:Laminar (default=1)"
      },
      "Visco": {
        "value": "0.00001",
        "comment": "Viscosity value. Typically 0.01 for Artificial and 1e-6 m^2/s (water kinematic viscosity) for Laminar"
      },
      "ViscoBoundFactor": {
        "value": "1",
        "comment": "Multiply viscosity value with boundary (default=1)"
      },
      "DensityDT": {
        "value": "1",
        "comment": "Density Diffusion Term 0:None, 1:Molteni, 2:Fourtakas, 3:Fourtakas(full) (default=0)"
      },
      "DensityDTvalue": {
        "value": "0.1",
        "comment": "DDT value (default=0.1)"
      },
      "Shifting": {
        "value": "2",
        "comment": "Shifting mode 0:None, 1:Ignore bound, 2:Ignore fixed, 3:Full (default=0)"
      },
      "ShiftCoef": {
        "value": "-2",
        "comment": "Coefficient for shifting computation (default=-2)"
      },
      "ShiftTFS": {
        "value": "0",
        "comment": "Threshold to detect free surface. Typically 1.5 for 2D and 2.75 for 3D. Set to 0 for internal flows (default=0)"
      },
      "RigidAlgorithm": {
        "value": "1",
        "comment": "Rigid Algorithm 0:collision-free, 1:SPH, 2:DEM, 3:Chrono (default=1)"
      },
      "FtPause": {
        "value": "0.0",
        "comment": "Time to freeze the floatings at simulation start (warmup) (default=0)",
        "units_comment": "seconds"
      },
      "CoefDtMin": {
        "value": "0.01",
        "comment": "Coefficient to calculate minimum time step dtmin=coefdtmin*h/speedsound (default=0.05)"
      },
      "DtIni": {
        "value": "0",
        "comment": "Initial time step. Use 0 to default use (default=h/speedsound)",
        "units_comment": "seconds"
      },
      "DtMin": {
        "value": "0",
        "comment": "Minimum time step. Use 0 to default use (default=coefdtmin*h/speedsound)",
        "units_comment": "seconds"
      },
      "DtFixed": {
        "value": "0",
        "comment": "Fixed Dt value. Use 0 to disable (default=disabled)",
        "units_comment": "seconds"
      },
      "DtFixedFile": {
        "value": "NONE",
        "comment": "Dt values are loaded from file. Use NONE to disable (default=disabled)",
        "units_comment": "milliseconds (ms)"
      },
      "DtAllParticles": {
        "value": "0",
        "comment": "Velocity of particles used to calculate DT. 1:All, 0:Only fluid/floating (default=0)"
      },
      "TimeMax": {
        "value": "2.5",
        "comment": "Time of simulation",
        "units_comment": "seconds"
      },
      "TimeOut": {
        "value": "0.01",
        "comment": "Time out data",
        "units_comment": "seconds"
      },
      "PartsOutMax": {
        "value": "1",
        "comment": "%/100 of fluid particles allowed to be excluded from domain (default=1)",
        "units_comment": "decimal"
      },
      "RhopOutMin": {
        "value": "700",
        "comment": "Minimum rhop valid (default=700)",
        "units_comment": "kg/m^3"
      },
      "RhopOutMax": {
        "value": "1300",
        "comment": "Maximum rhop valid (default=1300)",
        "units_comment": "kg/m^3"
      }
    },
