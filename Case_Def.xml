<case app="DualSPHysics" version="5.x">
  <casedef>
    <constantsdef>
      <gravity x="0" y="0" z="-9.81" comment="Gravitational acceleration" units_comment="m/s^2"/>
      <rhop0 value="1000" comment="Reference density of the fluid" units_comment="kg/m^3"/>
      <rhopgradient value="2" comment="Initial density gradient 1:Rhop0, 2:Water column, 3:Max. water height (default=2)"/>
      <hswl value="0" auto="true" comment="Maximum still water level to calculate speedofsound using coefsound" units_comment="metres (m)"/>
      <gamma value="7" comment="Polytropic constant for water used in the state equation"/>
      <speedsystem value="0" auto="true" comment="Maximum system speed (auto from dam-break propagation)"/>
      <coefsound value="20" comment="Coefficient to multiply speedsystem"/>
      <speedsound value="0" auto="true" comment="Speed of sound (auto: coefsound*speedsystem)"/>
      <coefh value="1.0" comment="Smoothing length coefficient (h=coefh*sqrt(3*Dp^2) in 3D)"/>
      <cflnumber value="0.2" comment="CFL coefficient"/>
    </constantsdef>

    <mkconfig boundcount="240" fluidcount="10"/>

    <geometry>
      <predefinition>
        <newvarcte mdbc="false"/>
        <newvarcte dom_padding="0.1"/>
        <newvarcte tank_min_x="0.0" tank_max_x="4.0" tank_min_z="0.0" tank_max_z="3.0"/>
        <newvarcte fluid_min_x="#tank_min_x+Dp" fluid_max_x="1.0" fluid_min_z="#tank_min_z+Dp" fluid_max_z="2.0"/>
      </predefinition>

      <definition dp="0.01" units_comment="metres (m)">
        <pointref x="0" y="0" z="0"/>
        <pointmin x="-2.10" y="-0.2" z="-1.5"/>
        <pointmax x="6.14" y="0.2" z="4.5"/>
      </definition>

      <commands>
        <list name="GeometryForNormals">
          <setactive drawpoints="0" drawshapes="1"/>
          <setshapemode>actual | bound</setshapemode>
          <setmkbound mk="0"/>
          <drawextrude closed="false">
            <point x="#tank_min_x+Dp/2" y="#-dom_padding" z="#tank_max_z"/>
            <point x="#tank_min_x+Dp/2" y="#-dom_padding" z="#tank_min_z+Dp/2"/>
            <point x="#tank_max_x-Dp/2" y="#-dom_padding" z="#tank_min_z+Dp/2"/>
            <point x="#tank_max_x-Dp/2" y="#-dom_padding" z="#tank_max_z"/>
            <extrude x="0" y="#2*dom_padding" z="0"/>
          </drawextrude>
          <shapeout file="hdp"/>
          <resetdraw/>
        </list>

        <mainlist>
          <runlist name="GeometryForNormals"/>
          <setdrawmode mode="full"/>

          <setmkbound mk="0"/>
          <drawbox boxfill="left | right">
            <point x="#tank_min_x" y="#-dom_padding" z="#tank_min_z"/>
            <size  x="#tank_max_x-tank_min_x" y="#2*dom_padding" z="#tank_max_z-tank_min_z"/>
            <layers vdp="0,1,2,3,4"/>
          </drawbox>

          <drawbox boxfill="bottom">
            <point x="#tank_min_x-4*Dp" y="#-dom_padding" z="#tank_min_z"/>
            <size  x="#tank_max_x-tank_min_x+8*Dp" y="#2*dom_padding" z="#tank_max_z-tank_min_z"/>
            <layers vdp="0,1,2,3,4,5,6,7,8"/>
          </drawbox>

          <setmkfluid mk="0"/>
          <drawbox boxfill="solid">
            <point x="#fluid_min_x" y="#-dom_padding" z="#fluid_min_z"/>
            <size  x="#fluid_max_x-fluid_min_x" y="#2*dom_padding" z="#fluid_max_z-fluid_min_z"/>
          </drawbox>
        </mainlist>
      </commands>
    </geometry>

    <normals>
      <distanceh value="2.0"/>
      <geometryfile file="[CaseName]_hdp_Actual.vtk"/>
    </normals>
  </casedef>

  <execution>
    <special>
      <gauges>
        <default>
          <savevtkpart value="true" comment="Creates VTK per PART"/>
          <computedt value="0.001" comment="Measure step (s)" units_comment="s"/>
          <output value="true" comment="Creates CSV files of measurements"/>
          <outputdt value="0" comment="Time between outputs (0=TimeOut)" units_comment="s"/>
        </default>
        <swl name="Swl_z003">
          <computedt value="0.005" comment="SWL compute dt" units_comment="s"/>
          <outputdt value="0.005" comment="SWL output dt" units_comment="s"/>
          <pointdp coefdp="0.5" comment="Spacing=coefdp*Dp"/>
          <point0 x="-0.5" y="0" z="0.03" comment="Initial point" units_comment="m"/>
          <point2 x="6.0"  y="0" z="0.03" comment="Final point" units_comment="m"/>
        </swl>
      </gauges>
    </special>

    <parameters>
      <parameter key="Boundary"        value="#eval(mdbc,2,1)" comment="Boundary method 1:DBC, 2:mDBC (default=1)"/>
      <parameter key="StepAlgorithm"   value="1" comment="1:Verlet, 2:Symplectic (default=1)"/>
      <parameter key="Kernel"          value="2" comment="1:Cubic Spline, 2:Wendland (default=2)"/>
      <parameter key="ViscoTreatment"  value="1" comment="1:Artificial, 2:Laminar+SPS, 3:Laminar (default=1)"/>
      <parameter key="Visco"           value="0.02" comment="Viscosity value (Artificial)"/>
      <parameter key="ViscoBoundFactor" value="1" comment="Multiply viscosity value with boundary (default=1)"/>
      <parameter key="DensityDT"       value="2" comment="Density Diffusion Term 0:None, 1:Molteni, 2:Fourtakas, 3:Fourtakas(full)"/>
      <parameter key="DensityDTvalue"  value="0.1" comment="DDT value (default=0.1)"/>
      <parameter key="Shifting"        value="0" comment="Shifting 0:None, 1:Ignore bound, 2:Ignore fixed, 3:Full"/>
      <parameter key="ShiftCoef"       value="-2" comment="Shift coefficient"/>
      <parameter key="ShiftTFS"        value="1.5" comment="Free-surface threshold (typ. 1.5 for 2D)"/>
      <parameter key="CoefDtMin"       value="0.05" comment="dtmin=coefdtmin*h/speedsound"/>
      <parameter key="DtAllParticles"  value="1" comment="Velocity for DT: 1:All, 0:Only fluid/floating"/>
      <parameter key="TimeMax"         value="2.0" comment="Simulation time" units_comment="s"/>
      <parameter key="TimeOut"         value="0.01" comment="Output interval" units_comment="s"/>
      <parameter key="MinFluidStop"    value="0.0" comment="0:Never stops on fluid loss"/>
      <parameter key="SavePosDouble"   value="0" comment="Save positions using double precision"/>
      <simulationdomain>
        <posmax x="default" y="default" z="default"/>
      </simulationdomain>
    </parameters>

    <motion/>
  </execution>
</case>