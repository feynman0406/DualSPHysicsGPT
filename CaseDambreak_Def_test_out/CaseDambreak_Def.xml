<case app="GenCase v5.4.354.01 (07-04-2025)" date="27-09-2025 00:45:52">
    <casedef>
        <constantsdef>
            <gravity x="0" y="0" z="-9.81" comment="Gravitational acceleration" units_comment="m/s^2" />
            <rhop0 value="1000" comment="Reference density of the fluid" units_comment="kg/m^3" />
            <rhopgradient value="2" comment="Initial density gradient 1:Rhop0, 2:Water column, 3:Max. water height (default=2)" />
            <hswl value="0" auto="true" comment="Max still water level for speed of sound via coefsound" units_comment="m" />
            <gamma value="7" comment="Tait EOS exponent for water" />
            <speedsystem value="0" auto="true" comment="Max system speed (auto from dam-break propagation)" />
            <coefsound value="20" comment="Speedsound = coefsound * speedsystem" />
            <speedsound value="0" auto="true" comment="Auto speed of sound" />
            <coefh value="1.0" comment="h = coefh * sqrt(3*dp^2) in 3D" />
            <_hdp value="2" comment="Alternative: h = hdp * dp" />
            <cflnumber value="0.2" comment="CFL number" />
        </constantsdef>
        <!-- 2D-style: use very thin Y thickness = Dp -->
        <mkconfig boundcount="20" fluidcount="20" />
        <geometry>
            <definition dp="0.01" units_comment="m">
                <pointmin x="0.0" y="0.0" z="0.0" />
                <pointmax x="1.6" y="0.01" z="0.4" />
            </definition>
            <commands>
                <mainlist>
                    <!-- DBC boundary generation (faces), not mDBC -->
                    <setshapemode>dp | bound</setshapemode>
                    <setdrawmode mode="full" />
                    <!-- Fluid column (left-bottom corner), size 0.4 x (Dp) x 0.3 m -->
                    <setmkfluid mk="0" />
                    <drawbox>
                        <boxfill>solid</boxfill>
                        <point x="0.0" y="0.0" z="0.0" />
                        <size x="0.4" y="0.01" z="0.3" />
                    </drawbox>
                    <!-- Tank walls: bottom, left, right, front, back (top open) -->
                    <setmkbound mk="0" />
                    <drawbox>
                        <boxfill>bottom | left | right | front | back</boxfill>
                        <point x="0.0" y="0.0" z="0.0" />
                        <size x="1.6" y="0.01" z="0.4" />
                    </drawbox>
                    <shapeout file="Tank" />
                </mainlist>
            </commands>
        </geometry>
    </casedef>
    <execution>
        <parameters>
            <parameter key="SavePosDouble" value="0" comment="Save double-precision positions (0=off)" />
            <parameter key="StepAlgorithm" value="1" comment="1:Verlet, 2:Symplectic" />
