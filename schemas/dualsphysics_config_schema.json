{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DualSPHysics Configuration Schema (GOS) - Strict Mode",
  "description": "Generator Output Schema for DualSPHysics case configurations. All mandatory fields for OpenAI strict-response compatibility.",
  "type": "object",
  "required": [
    "constants",
    "mkconfig",
    "geometry",
    "execution"
  ],
  "properties": {
    "constants": {
      "type": "object",
      "description": "Physical constants and simulation parameters",
      "required": [
        "gravity",
        "rhop0",
        "rhopgradient",
        "hswl",
        "gamma",
        "speedsystem",
        "coefsound",
        "speedsound",
        "coefh",
        "_hdp",
        "cflnumber"
      ],
      "properties": {
        "gravity": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "rhop0": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "rhopgradient": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "hswl": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "gamma": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "speedsystem": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "coefsound": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "speedsound": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "coefh": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "_hdp": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "cflnumber": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mkconfig": {
      "type": "object",
      "description": "MK (marker) configuration",
      "required": [
        "boundcount",
        "fluidcount"
      ],
      "properties": {
        "boundcount": {
          "type": "integer",
          "minimum": 0
        },
        "fluidcount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": [
        "definition",
        "commands"
      ],
      "properties": {
        "definition": {
          "type": "object",
          "required": [
            "dp",
            "pointmin",
            "pointmax"
          ],
          "properties": {
            "dp": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pointmin": {
              "$ref": "#/definitions/vector"
            },
            "pointmax": {
              "$ref": "#/definitions/vector"
            }
          },
          "patternProperties": {
            "^meta$": {
              "type": "object",
              "patternProperties": {
                "^comment$": {
                  "type": "string"
                },
                "^units_comment$": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "^children$": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            }
          },
          "additionalProperties": false
        },
        "commands": {
          "type": "object",
          "required": [
            "mainlist"
          ],
          "properties": {
            "mainlist": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/commandNode"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "normals": {
      "$ref": "#/definitions/normalsNode"
    },
    "execution": {
      "type": "object",
      "required": [
        "parameters"
      ],
      "properties": {
        "parameters": {
          "type": "object",
          "required": [
            "Boundary",
            "CoefDtMin",
            "DensityDT",
            "DensityDTvalue",
            "DtAllParticles",
            "DtFixed",
            "DtFixedFile",
            "DtIni",
            "DtMin",
            "FtIgnoreRadius",
            "FtPause",
            "Kernel",
            "MinFluidStop",
            "NoPenetration",
            "PartsOutMax",
            "RhopOutMax",
            "RhopOutMin",
            "RigidAlgorithm",
            "SavePosDouble",
            "ShiftCoef",
            "ShiftTFS",
            "Shifting",
            "SlipMode",
            "StepAlgorithm",
            "TimeMax",
            "TimeOut",
            "VerletSteps",
            "Visco",
            "ViscoBoundFactor",
            "ViscoTreatment",
            "WrnPartsOut",
            "XPeriodicIncZ"
          ],
          "properties": {
            "TimeMax": {
              "$ref": "#/definitions/parameterEntry"
            },
            "TimeOut": {
              "$ref": "#/definitions/parameterEntry"
            },
            "SavePosDouble": {
              "$ref": "#/definitions/parameterEntry"
            },
            "StepAlgorithm": {
              "$ref": "#/definitions/parameterEntry"
            },
            "VerletSteps": {
              "$ref": "#/definitions/parameterEntry"
            },
            "Kernel": {
              "$ref": "#/definitions/parameterEntry"
            },
            "ViscoTreatment": {
              "$ref": "#/definitions/parameterEntry"
            },
            "Visco": {
              "$ref": "#/definitions/parameterEntry"
            },
            "ViscoBoundFactor": {
              "$ref": "#/definitions/parameterEntry"
            },
            "DensityDT": {
              "$ref": "#/definitions/parameterEntry"
            },
            "DensityDTvalue": {
              "$ref": "#/definitions/parameterEntry"
            },
            "Shifting": {
              "$ref": "#/definitions/parameterEntry"
            },
            "ShiftCoef": {
              "$ref": "#/definitions/parameterEntry"
            },
            "ShiftTFS": {
              "$ref": "#/definitions/parameterEntry"
            },
            "RigidAlgorithm": {
              "$ref": "#/definitions/parameterEntry"
            },
            "FtPause": {
              "$ref": "#/definitions/parameterEntry"
            },
            "CoefDtMin": {
              "$ref": "#/definitions/parameterEntry"
            },
            "DtIni": {
              "$ref": "#/definitions/parameterEntry"
            },
            "DtMin": {
              "$ref": "#/definitions/parameterEntry"
            },
            "DtFixed": {
              "$ref": "#/definitions/parameterEntry"
            },
            "DtFixedFile": {
              "$ref": "#/definitions/parameterEntry"
            },
            "DtAllParticles": {
              "$ref": "#/definitions/parameterEntry"
            },
            "RhopOutMin": {
              "$ref": "#/definitions/parameterEntry"
            },
            "RhopOutMax": {
              "$ref": "#/definitions/parameterEntry"
            },
            "Boundary": {
              "$ref": "#/definitions/parameterEntry"
            },
            "WrnPartsOut": {
              "$ref": "#/definitions/parameterEntry"
            },
            "MinFluidStop": {
              "$ref": "#/definitions/parameterEntry"
            },
            "SlipMode": {
              "$ref": "#/definitions/parameterEntry"
            },
            "PartsOutMax": {
              "$ref": "#/definitions/parameterEntry"
            },
            "NoPenetration": {
              "$ref": "#/definitions/parameterEntry"
            },
            "FtIgnoreRadius": {
              "$ref": "#/definitions/parameterEntry"
            },
            "XPeriodicIncZ": {
              "$ref": "#/definitions/parameterEntry"
            }
          },
          "additionalProperties": true
        },
        "children_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters_children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameterChildPlan"
          }
        },
        "special_children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/specialChildPlan"
          }
        },
        "special": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/genericNode"
          }
        },
        "wavepaddles": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            }
          },
          "additionalProperties": true
        },
        "timeout": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            }
          },
          "additionalProperties": true
        },
        "relaxation_zones": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            }
          },
          "additionalProperties": true
        },
        "particle_filters": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/genericNode"
              }
            }
          },
          "additionalProperties": true
        },
        "gauges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/gaugeEntry"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "vector": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "genericNode": {
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "type": "string"
        },
        "vector": {
          "$ref": "#/definitions/vector"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/genericNode"
          }
        },
        "text": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "commandNode": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "setshapemode",
            "setdrawmode",
            "setmkbound",
            "setmkfluid",
            "drawbox",
            "fillbox",
            "shapeout"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/genericNode"
          }
        },
        "text": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "parameterEntry": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "comment": {
          "type": "string"
        },
        "units_comment": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "auto": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "parameterChildPlan": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "parameter",
            "generic"
          ]
        },
        "key": {
          "type": "string"
        },
        "spec": {
          "$ref": "#/definitions/genericNode"
        }
      },
      "additionalProperties": true
    },
    "specialChildPlan": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "known",
            "generic"
          ]
        },
        "key": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "spec": {
          "$ref": "#/definitions/genericNode"
        }
      },
      "additionalProperties": true
    },
    "gaugeEntry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "start": {
          "$ref": "#/definitions/vector"
        },
        "mid": {
          "$ref": "#/definitions/vector"
        },
        "end": {
          "$ref": "#/definitions/vector"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/genericNode"
          }
        },
        "children_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "normalsNode": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "comment": {
          "type": "string"
        },
        "norgeometry": {
          "$ref": "#/definitions/norgeometryNode"
        },
        "extra": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/genericNode"
          }
        },
        "structured_meta": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "norgeometry"
      ],
      "additionalProperties": true
    },
    "norgeometryNode": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "geometryfile": {
          "$ref": "#/definitions/normalsGeometryFileNode"
        },
        "distanceh": {
          "$ref": "#/definitions/normalsDistanceNode"
        },
        "svshapes": {
          "$ref": "#/definitions/normalsSvshapesNode"
        },
        "extra": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/genericNode"
          }
        }
      },
      "additionalProperties": true
    },
    "normalsGeometryFileNode": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "normalsDistanceNode": {
      "type": "object",
      "required": [
        "v"
      ],
      "properties": {
        "v": {
          "type": "number"
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "normalsSvshapesNode": {
      "type": "object",
      "required": [
        "v"
      ],
      "properties": {
        "v": {
          "type": "boolean"
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
